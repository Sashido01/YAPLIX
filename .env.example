# Optional server-side BGen configuration. No LLM keys belong in YAPLIX UI.
PORT=3000
YAPLIX_DB=.local/data/yaplix.sqlite
BGEN_TIMEOUT_MS=30000
LIVE_PROVIDER=none
# For LIVE via Ollama: install Ollama and model, npm run bgen:install,
# then set LIVE_PROVIDER=ollama. DEMO needs none of these.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:14b
LLM_TIMEOUT_MS=180000
# BGEN_URL=https://your-generator.example
# BGEN_INIT_DATA= (short-lived Telegram initData, if upstream requires it)

# Default local access. List interfaces: npm run lan -- --list.
# Then choose explicitly: npm run lan -- --host <Wi-Fi/Ethernet IPv4> --port 3000.
YAPLIX_MODE=local
YAPLIX_HOST=127.0.0.1
# LAN/HTTPS shared team access: 32..128 URL-safe random characters.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# YAPLIX_ACCESS_KEY=
# Without this override, lan reuses the ignored .local/lan-access.key.
# HTTPS behind a loopback reverse proxy:
# YAPLIX_MODE=https
# PUBLIC_URL=https://games.example.com
