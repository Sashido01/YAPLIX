# Server secrets stay here, never in URLs/HTML/Git.
PORT=3000
YAPLIX_DB=.local/data/yaplix.sqlite
LIVE_PROVIDER=cloud
CLOUD_BASE_URL=https://openrouter.ai/api/v1
CLOUD_MODEL=google/gemma-4-31b-it:free
CLOUD_API_KEY=
LLM_TIMEOUT_MS=180000
LLM_REQUEST_TIMEOUT_MS=45000
LLM_MAX_ATTEMPTS=4
LLM_MAX_DURATION_MS=300000
LLM_RETRY_MS=2000
LLM_MAX_TOKENS=12000
LLM_TOKEN_FIELD=max_tokens
# spec = local structured envelope (no extra LLM request); direct = text envelope.
LLM_PROMPT_STYLE=direct
# Optional: LLM_TEMPERATURE=0.2 (omit if unsupported)
LLM_REPAIRS=2
LLM_FALLBACK=none
# Optional Ollama Cloud secondary: LLM_FALLBACK=ollama-cloud
# Or explicit cloud primary: LIVE_PROVIDER=ollama-cloud
# Fixed endpoint https://ollama.com/v1; set exact ID from official models API.
# OLLAMA_CLOUD_API_KEY=
# OLLAMA_CLOUD_MODEL=
# A configured :free OpenRouter ID requires explicit zero token prices.
# When LIVE_PROVIDER=ollama-cloud, LLM_FALLBACK=openrouter uses CLOUD_* as backup.
# Generic secondary requires all three. OpenRouter blocks nonfree generic secondary.
# SECONDARY_BASE_URL=https://your-compatible-provider.example/v1
# SECONDARY_MODEL=exact-model-id
# SECONDARY_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:14b
# Optional explicit local third route, only after installing the local model:
# LLM_LOCAL_FALLBACK=1
PLAYWRIGHT_BROWSERS_PATH=.local/playwright
YAPLIX_MODE=local
YAPLIX_HOST=127.0.0.1
# LAN: npm run lan -- --list, then select a private interface explicitly.
# HTTPS: loopback reverse proxy, YAPLIX_MODE=https and exact PUBLIC_URL.
# YAPLIX_ACCESS_KEY= (32..128 URL-safe random characters)
# PUBLIC_URL=https://games.example.com
TELEGRAM_BOT_USERNAME=YaplixBot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_AUTH_MAX_AGE=300
# Default: polling when token + exactly one owner are configured. One consumer.
TELEGRAM_UPDATES=polling
