{
  "name": "yaplix",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "start": "node src/server.ts",
    "demo:live": "node scripts/live-generation.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:browser": "npm run build && node scripts/browser-tests.mjs test",
    "browsers:install": "node scripts/browser-tests.mjs install chromium webkit",
    "check": "npm run typecheck && npm test && npm run test:browser"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
