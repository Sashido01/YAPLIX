{
  "name": "yaplix",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "lan": "node --env-file-if-exists=.env scripts/lan.ts",
    "demo:live": "node --env-file-if-exists=.env scripts/live-generation.ts",
    "bgen:install": "node scripts/install-bgen.ts",
    "doctor": "node --env-file-if-exists=.env scripts/maintenance.ts doctor",
    "backup": "node --env-file-if-exists=.env scripts/maintenance.ts backup",
    "verify:backup": "node scripts/maintenance.ts verify-backup",
    "build": "tsc && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.ts",
    "test:browser": "npm run build && node scripts/browser-tests.mjs test",
    "browsers:install": "node scripts/browser-tests.mjs install chromium webkit firefox",
    "performance:smoke": "npm run build && node scripts/browser-tests.mjs performance",
    "check": "npm run typecheck && npm test && npm run test:browser"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "hono": "4.13.13",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/pngjs": "6.0.5",
    "esbuild": "0.28.2",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0",
    "typescript": "7.0.2"
  }
}
