{
  "name": "yaplix",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "app": "node --env-file-if-exists=.env scripts/app.mjs",
    "benchmark:generation": "node --env-file-if-exists=.env scripts/generation-benchmark.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "lan": "node --env-file-if-exists=.env scripts/lan.ts",
    "demo:live": "node --env-file-if-exists=.env scripts/live-generation.ts",
    "checker:install": "node scripts/browser-tests.mjs install chromium",
    "telegram:check": "node --env-file-if-exists=.env scripts/telegram-setup.ts check",
    "telegram:id": "node --env-file-if-exists=.env scripts/telegram-setup.ts id",
    "telegram:menu": "node --env-file-if-exists=.env scripts/telegram-setup.ts menu",
    "tunnel:install": "node scripts/tunnel.ts install",
    "tunnel": "node --env-file-if-exists=.env scripts/tunnel.ts",
    "network:check": "node --env-file-if-exists=.env scripts/llm-network-check.ts",
    "doctor": "node --env-file-if-exists=.env scripts/maintenance.ts doctor",
    "backup": "node --env-file-if-exists=.env scripts/maintenance.ts backup",
    "verify:backup": "node scripts/maintenance.ts verify-backup",
    "build": "tsc && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.ts",
    "test:browser": "npm run build && node scripts/browser-tests.mjs test",
    "browsers:install": "node scripts/browser-tests.mjs install chromium webkit firefox",
    "performance:smoke": "npm run build && node scripts/browser-tests.mjs performance",
    "check": "npm run typecheck && npm test && npm run test:browser",
    "doctor:providers": "node --env-file-if-exists=.env scripts/provider-configuration.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "hono": "4.13.13",
    "jose": "6.2.12",
    "playwright-core": "1.64.0",
    "qrcode-generator": "2.0.4",
    "undici": "8.12.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "@types/pngjs": "6.0.5",
    "esbuild": "0.28.2",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0",
    "typescript": "7.0.2"
  }
}
